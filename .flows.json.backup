    {
        "id": "efb5ce3e058987e0",
        "type": "function",
        "z": "b8938632cee28714",
        "name": "Manual Pump",
        "func": "const mode = flow.get(\"systemMode\") || \"AUTO\";\n\nif (mode !== \"MANUAL\") {\n    node.warn(\"Hãy chuyển sang MANUAL trước khi điều khiển bơm.\");\n    return null;\n}\n\nif (msg.payload !== \"ON\" && msg.payload !== \"OFF\") {\n    return null;\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 620,
        "y": 1080,
        "wires": [
            [
                "3589937dec0c0c76"
            ]
        ]
    },
