    {
        "id": "aa9117e8852aa398",
        "type": "function",
        "z": "0b3cdf6d1aa31616",
        "name": "RULE 2: Offline Detection",
        "func": "// AUTOMATION RULE 2\n// Nếu không nhận được dữ liệu trong 60 giây → coi là OFFLINE\n\nconst TIMEOUT_MS = 60000;  // 60 giây\nconst lastData = flow.get('lastDataTime') || 0;\nconst deviceOnline = flow.get('deviceOnline');\nconst elapsed = Date.now() - lastData;\nconst time = new Date().toLocaleString('vi-VN');\n\nif (lastData > 0 && elapsed > TIMEOUT_MS) {\n    if (deviceOnline !== false) {\n        flow.set('deviceOnline', false);\n        node.status({ fill:'red', shape:'dot', text:'OFFLINE! ' + Math.round(elapsed/1000) + 's' });\n        \n        const alertMsg = { \n            payload: `🔴 [${time}] ⚠ CANH BAO: ESP32 mat ket noi! Khong nhan du lieu trong ${Math.round(elapsed/1000)} giay.` \n        };\n        const logMsg = { \n            payload: `[${time}] [RULE2 OFFLINE] Timeout=${Math.round(elapsed/1000)}s → DeviceOffline\\n` \n        };\n        return [alertMsg, logMsg];\n    }\n} else {\n    if (deviceOnline === false && elapsed <= TIMEOUT_MS) {\n        flow.set('deviceOnline', true);\n    }\n    node.status({ fill:'green', shape:'dot', text:'Online – ' + Math.round(elapsed/1000) + 's ago' });\n}\n\nreturn null;",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "node.status({ fill:'grey', shape:'ring', text:'Khoi dong...' });",
