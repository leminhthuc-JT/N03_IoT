    {
        "id": "cf6c395ac42e26e0",
        "type": "function",
        "z": "b8938632cee28714",
        "name": "Tạo dòng CSV",
        "func": "const d = msg.payload;\n\nconst time = new Date().toLocaleString(\"sv-SE\", {\n    timeZone: \"Asia/Ho_Chi_Minh\"\n});\n\nmsg.payload =\n    `${time},${d.moisture},${d.adc},${d.pump},${d.valve},${d.mode}\\r\\n`;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 620,
        "y": 820,
        "wires": [
