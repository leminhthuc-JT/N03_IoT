    {
        "id": "76c0d856c13352f9",
        "type": "function",
        "z": "5797212a039625af",
        "name": "LWT Status Handler",
        "func": "const status = msg.payload.trim().toUpperCase();\nconst time = new Date().toLocaleString('vi-VN');\n\nif (status === 'ONLINE') {\n    flow.set('deviceOnline', true);\n    flow.set('lastDataTime', Date.now());\n    const alert = { payload: `🟢 [${time}] ESP32 đã kết nối` };\n    const log = { payload: `[${time}] [STATUS] ESP32 -> ONLINE\\n` };\n    return [[alert], [log]];\n} else if (status === 'OFFLINE') {\n    flow.set('deviceOnline', false);\n    const alert = { payload: `🔴 [${time}] ⚠ ESP32 MẤT KẾT NỐI (LWT OFFLINE)` };\n    const log = { payload: `[${time}] [STATUS] ESP32 -> OFFLINE (LWT)\\n` };\n    return [[alert], [log]];\n}\nreturn null;",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 900,
        "wires": [
            [
                "fabb10b0912be178",
                "685b01a8ce5dbfb3"
            ],
            [
                "ee5be110cf2f121b"
            ]
        ]
    },
    {
        "id": "6b50c81787227691",
        "type": "function",
        "z": "0b3cdf6d1aa31616",
        "name": "RULE 1: Auto Pump by Moisture Threshold",
        "func": "// AUTOMATION RULE 1\n// Nếu mode = AUTO và độ ẩm vượt ngưỡng → gửi lệnh bơm\n\nconst d = msg.payload;\nconst mode = flow.get('systemMode') || 'AUTO';\n\nif (mode !== 'AUTO') {\n    // Đang ở MANUAL → không can thiệp\n    return null;\n}\n\nconst DRY = 35;\nconst WET = 60;\nconst lastPump = flow.get('lastPumpStatus');\nconst time = new Date().toLocaleString('vi-VN');\n\nlet command = null;\nlet logText = null;\n\nif (d.moisture < DRY && !lastPump) {\n    // Đất khô, bơm đang tắt → BẬT bơm\n    command = { payload: 'ON' };\n    logText = `[${time}] [AUTO RULE 1] Do am=${d.moisture}% < ${DRY}% → BAT BOM`;\n    node.status({ fill:'green', shape:'dot', text:'BAT BOM: ' + d.moisture + '%' });\n} else if (d.moisture >= WET && lastPump) {\n    // Đủ ẩm, bơm đang bật → TẮT bơm\n    command = { payload: 'OFF' };\n    logText = `[${time}] [AUTO RULE 1] Do am=${d.moisture}% >= ${WET}% → TAT BOM`;\n    node.status({ fill:'blue', shape:'dot', text:'TAT BOM: ' + d.moisture + '%' });\n} else {\n    node.status({ fill:'grey', shape:'ring', text:'Vung trung gian: ' + d.moisture + '%' });\n    return null;\n}\n\nconst logMsg = { payload: logText + '\\n' };\nreturn [command, logMsg];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "node.status({ fill:'grey', shape:'ring', text:'Cho du lieu...' });",
        "finalize": "",
        "libs": [],
        "x": 500,
        "y": 160,
        "wires": [
