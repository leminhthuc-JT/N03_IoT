    {
        "id": "120172723d429f05",
        "type": "function",
        "z": "b8938632cee28714",
        "name": "Trạng thái",
        "func": "\nmsg.payload = msg.payload.pump;\n\nif(msg.payload == true){\n    msg.payload = \"ON\";\n}else{\n    msg.payload = \"OFF\";\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
