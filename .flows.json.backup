    {
        "id": "45da854689cef065",
        "type": "function",
        "z": "b8938632cee28714",
        "name": "Toggle Mode",
        "func": "let mode = flow.get(\"systemMode\") || \"AUTO\";\n\nmode = mode === \"AUTO\" ? \"MANUAL\" : \"AUTO\";\n\nflow.set(\"systemMode\", mode);\n\n// Output 1: gửi lệnh đến ESP32\nconst command = {\n    payload: mode\n};\n\n// Output 2: cập nhật chế độ trên Dashboard\nconst status = {\n    payload: \"Chế độ hiện tại: \" + mode\n};\n\nreturn [command, status];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 610,
        "y": 940,
        "wires": [
            [
                "47e19e112e3ed0c5"
            ],
            [
                "af47bf298f48564d"
            ]
        ]
    },
