        "z": "5797212a039625af",
        "name": "Validate & Parse JSON",
        "func": "// Kiểm tra và parse JSON payload\nlet d;\ntry {\n    d = (typeof msg.payload === 'string') ? JSON.parse(msg.payload) : msg.payload;\n} catch(e) {\n    node.warn('JSON parse error: ' + e.message + ' | raw: ' + msg.payload);\n    return null;\n}\n\n// Kiểm tra field bắt buộc\nif (d.moisture === undefined || d.pump === undefined || d.mode === undefined) {\n    node.warn('Thieu truong du lieu: ' + JSON.stringify(d));\n    return null;\n}\n\n// Kiểm tra giá trị hợp lệ\nif (d.moisture < 0 || d.moisture > 100) {\n    node.warn('Do am ngoai pham vi: ' + d.moisture);\n    return null;\n}\n\nmsg.payload = d;\n// Cập nhật thời điểm nhận dữ liệu cuối\nflow.set('lastDataTime', Date.now());\nflow.set('deviceOnline', true);\nflow.set('lastMoisture', d.moisture);\nflow.set('lastPumpStatus', d.pump);\nflow.set('lastMode', d.mode);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "flow.set('lastDataTime', Date.now());\nflow.set('deviceOnline', true);\nflow.set('systemMode', 'AUTO');",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 100,
