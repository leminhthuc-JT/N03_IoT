    {
        "id": "741debd07a5326fc",
        "type": "function",
        "z": "5797212a039625af",
        "name": "MANUAL Guard + Conflict Check",
        "func": "const mode = flow.get('systemMode') || 'AUTO';\n\nif (mode !== 'MANUAL') {\n    node.warn('[CONFLICT] Lenh bom bi bo qua: he thong dang o che do AUTO. Chuyen sang MANUAL truoc.');\n    // Thông báo cảnh báo xung đột\n    return [null, { payload: '⚠ Lệnh bị từ chối: Đang ở chế độ AUTO. Hãy chuyển sang MANUAL trước.' }];\n}\n\nif (msg.payload !== 'ON' && msg.payload !== 'OFF') {\n    node.warn('[INVALID] Payload khong hop le: ' + msg.payload);\n    return [null, null];\n}\n\n// Log sự kiện\nconst logMsg = {\n    payload: `[${new Date().toLocaleString('vi-VN')}] [PUMP_CMD] Node-RED Dashboard → ${msg.payload}\\n`\n};\n\nreturn [msg, { payload: 'Lệnh đã gửi: BƠM ' + msg.payload }, logMsg];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 450,
        "y": 730,
