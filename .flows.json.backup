    {
        "id": "efd5d9aff3301217",
        "type": "function",
        "z": "5797212a039625af",
        "name": "Toggle Mode Logic",
        "func": "let mode = flow.get('systemMode') || 'AUTO';\nmode = (mode === 'AUTO') ? 'MANUAL' : 'AUTO';\nflow.set('systemMode', mode);\n\nconst cmd = { payload: mode };\nconst statusMsg = { payload: 'Chế độ hiện tại: ' + mode };\n\n// Log sự kiện\nconst logMsg = {\n    payload: `[${new Date().toLocaleString('vi-VN')}] [MODE_CHANGE] Node-RED → Chuyen mode: ${mode}\\n`\n};\n\nreturn [cmd, statusMsg, logMsg];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
