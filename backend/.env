# Cấu hình Backend N03 Smart Garden Digital Twin Level 4
PORT=3001
MQTT_BROKER=mqtt://broker.hivemq.com:1883
MQTT_CLIENT_ID=N03-Backend-Server
TOPIC_TELEMETRY=garden/device01/telemetry
TOPIC_STATUS=garden/device01/status
TOPIC_COMMAND=garden/device01/command
TOPIC_ACK=garden/device01/ack
TOPIC_ALERT=garden/device01/alert

# Fallback & Legacy Topics
TOPIC_LEGACY_TELEMETRY=garden/demo/telemetry
TOPIC_LEGACY_STATUS=garden/demo/status

# Database
DB_PERSIST_FILE=./data/store.json
POSTGRES_ENABLED=false
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/n03_garden
INFLUX_ENABLED=false
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=n03-super-secret-token
INFLUX_ORG=n03-iot
INFLUX_BUCKET=garden-telemetry
